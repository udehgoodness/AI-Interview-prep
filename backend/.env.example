# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
OPENAI_MODEL=gpt-3.5-turbo  # Options: gpt-3.5-turbo, gpt-4, etc.
OPENAI_TEMPERATURE=0.7      # Range: 0.0 - 1.0, higher means more creative

# Server Configuration
TURN_SERVER_URL=your_turn_server_url          # Optional: WebRTC TURN server URL
TURN_SERVER_USERNAME=your_turn_username       # Optional: TURN server authentication
TURN_SERVER_PASSWORD=your_turn_password       # Optional: TURN server authentication

# Note: Never commit your actual .env file to version control
# Copy this file to .env and fill in your actual values 